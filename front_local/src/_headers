# JS/CSS con hash en el nombre: cache largo e inmutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Media exportada (cambia al re-exportar desde local)
/assets/media/*
  Cache-Control: public, max-age=86400

# JSON del portfolio: cache corto para ver cambios tras deploy
/assets/data/portfolio.json
  Cache-Control: public, max-age=300

# Cabeceras de seguridad basicas para el resto
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
