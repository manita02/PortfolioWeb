spring.jpa.hibernate.ddl-auto=update
spring.datasource.url=jdbc:mysql://localhost:3306/backendaj?useSSL=false&serverTimezone=UTC
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_CONTRASEÑA
# Imágenes BLOB: configurar max_allowed_packet=4M en MySQL (my.ini o SET GLOBAL). Ver README.md
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect
spring.mvc.pathmatch.matching-strategy=ant-path-matcher

spring.servlet.multipart.max-file-size=25MB
spring.servlet.multipart.max-request-size=25MB

# Imágenes del ABM: límite real ~2 MB (ArchivoUtil + frontend). Tomcat un poco más por base64 en JSON.
# Backups SQL (.sql): hasta 25 MB vía POST /api/backup/upload
server.tomcat.max-http-post-size=25MB
server.tomcat.max-swallow-size=25MB

jwt.secret=portfolioWebJwtSecretKeyLocalDev2024SecureSigningKey
jwt.expiration=86400

# Export A1: JSON + media hacia el frontend estatico (ruta relativa al directorio back_local)
static.export.output-dir=../front_local/src/assets
